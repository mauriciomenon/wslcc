<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WSLCC.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:WSLCC_App"
    xmlns:vm="using:WSLCC.App.ViewModels"
    mc:Ignorable="d"
    x:DataType="vm:SettingsViewModel">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
    </Page.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalContentAlignment="Stretch">
        <StackPanel Padding="36,24,36,32" Spacing="8" HorizontalAlignment="Stretch">

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{loc:Tr Key=Settings.TitleText.Text}"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadCommand}"
                    Content="{loc:Tr Key=Settings.ReloadButton.Content}" />
            </Grid>

            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasSaveMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.SaveMessage, Mode=OneWay}"
                Severity="Success"
                Title="{loc:Tr Key=Settings.SaveInfoBar.Title}" />
            <InfoBar
                x:Name="ErrorBar"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Title="{loc:Tr Key=Settings.ErrorInfoBar.Title}" />

            <controls:SettingsExpander
                Header="{loc:Tr Key=Settings.SessionSectionTitle.Text}"
                Description="{loc:Tr Key=Settings.SessionFileHint.Text}"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.SessionNameLabel.Text}" Description="{loc:Tr Key=Settings.SessionNameHint}">
                        <TextBox
                            Width="280"
                            PlaceholderText="{loc:Tr Key=Settings.SessionNameBox.PlaceholderText}"
                            Text="{x:Bind ViewModel.SessionName, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.StoragePathLabel.Text}" Description="{loc:Tr Key=Settings.StoragePathHint}">
                        <TextBox
                            Width="280"
                            PlaceholderText="{loc:Tr Key=Settings.StoragePathBox.PlaceholderText}"
                            Text="{x:Bind ViewModel.StoragePath, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.CpuCountLabel.Text}" Description="{loc:Tr Key=Settings.CpuHint}">
                        <TextBox
                            Width="280"
                            PlaceholderText="{loc:Tr Key=Settings.MemoryMbBox.PlaceholderText}"
                            Text="{x:Bind ViewModel.CpuCount, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.MemoryMbLabel.Text}" Description="{loc:Tr Key=Settings.MemoryHint}">
                        <TextBox
                            Width="280"
                            PlaceholderText="{loc:Tr Key=Settings.MemoryMbBox.PlaceholderText}"
                            Text="{x:Bind ViewModel.MemoryMb, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.MaxStorageSizeLabel.Text}" Description="{loc:Tr Key=Settings.DiskHint}">
                        <TextBox
                            Width="280"
                            PlaceholderText="{loc:Tr Key=Settings.DiskExample}"
                            Text="{x:Bind ViewModel.MaxStorageSize, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.IdleTimeoutLabel.Text}" Description="{loc:Tr Key=Settings.IdleHint}">
                        <TextBox
                            Width="280"
                            PlaceholderText="{loc:Tr Key=Settings.IdleExample}"
                            Text="{x:Bind ViewModel.IdleTimeout, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.BindingAddressLabel.Text}" Description="{loc:Tr Key=Settings.PortHint}">
                        <TextBox
                            Width="280"
                            PlaceholderText="{loc:Tr Key=Settings.BindingAddressBox.PlaceholderText}"
                            Text="{x:Bind ViewModel.BindingAddress, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.HostLoopbackLabel.Text}" Description="{loc:Tr Key=Settings.LoopbackHint}">
                        <TextBox
                            Width="280"
                            PlaceholderText="{loc:Tr Key=Settings.LoopbackExample}"
                            Text="{x:Bind ViewModel.HostLoopback, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.CredentialStoreLabel.Text}" Description="{loc:Tr Key=Settings.CredentialHint}">
                        <ComboBox
                            Width="280"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.CredentialStoreOptions, Mode=OneWay}"
                            SelectedValue="{x:Bind ViewModel.CredentialStore, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.SaveSession}" Description="{loc:Tr Key=Settings.SaveSessionHint}">
                        <Button Command="{x:Bind ViewModel.SaveCommand}" Content="{loc:Tr Key=Settings.SaveButton.Content}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Header="{loc:Tr Key=Settings.ImageCompose}"
                Description="{loc:Tr Key=Settings.ImageComposeHint}"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8F4;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.RegistryMirrorLabel.Text}" Description="{loc:Tr Key=Settings.MirrorHint}">
                        <TextBox
                            Width="280"
                            PlaceholderText="{loc:Tr Key=Settings.RegistryMirrorBox.PlaceholderText}"
                            Text="{x:Bind ViewModel.RegistryMirror, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.ComposeDirectoryLabel.Text}" Description="{loc:Tr Key=Settings.ComposeDirectoryHint}">
                        <TextBox
                            Width="280"
                            PlaceholderText="{loc:Tr Key=Settings.ComposeDirectoryBox.PlaceholderText}"
                            Text="{x:Bind ViewModel.ComposeDirectory, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Header="{loc:Tr Key=Settings.StartupTray}"
                Description="{loc:Tr Key=Settings.StartupTrayHint}"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.StartupToggle.Header}" Description="{loc:Tr Key=Settings.StartupToggle.OnContent}">
                        <ToggleSwitch
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            IsOn="{x:Bind ViewModel.StartupEnabled, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.StartupContainersToggle.Header}" Description="{loc:Tr Key=Settings.StartupContainersToggle.OnContent}">
                        <ToggleSwitch
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            IsOn="{x:Bind ViewModel.StartupContainersEnabled, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.AutoCheckUpdateToggle.Header}" Description="{loc:Tr Key=Settings.AutoCheckUpdateToggle.OnContent}">
                        <ToggleSwitch
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            IsOn="{x:Bind ViewModel.AutoCheckUpdate, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.MinimizeTrayNotifyToggle.Header}" Description="{loc:Tr Key=Settings.MinimizeTrayNotifyToggle.OnContent}">
                        <ToggleSwitch
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            IsOn="{x:Bind ViewModel.MinimizeTrayNotify, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.TrayPanel}" Description="{loc:Tr Key=Settings.TrayPanelHint}">
                        <ToggleSwitch
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            IsOn="{x:Bind ViewModel.TrayMiniPanel, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.StartMinimized}" Description="{loc:Tr Key=Settings.StartMinimizedHint}">
                        <ToggleSwitch
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.CloseBehaviorLabel.Text}" Description="{loc:Tr Key=Settings.CloseHint}">
                        <ComboBox
                            Width="280"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.CloseBehaviorOptions, Mode=OneWay}"
                            SelectedValue="{x:Bind ViewModel.CloseBehavior, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Header="{loc:Tr Key=Settings.AppearanceSectionTitle.Text}"
                Description="{loc:Tr Key=Settings.AppearanceHint}"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.LanguageLabel.Text}" Description="{loc:Tr Key=Settings.LanguageRestartHint.Text}">
                        <ComboBox
                            x:Name="LanguageSelector"
                            Width="200"
                            AutomationProperties.Name="{loc:Tr Key=Settings.LanguageLabel.Text}"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                            SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.ThemeLabel}" Description="{loc:Tr Key=Settings.ThemeHint}">
                        <ComboBox
                            Width="200"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                            SelectedValue="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{loc:Tr Key=Settings.BackdropLabel}" Description="{loc:Tr Key=Settings.BackdropHint}">
                        <ComboBox
                            Width="200"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.BackdropOptions, Mode=OneWay}"
                            SelectedValue="{x:Bind ViewModel.BackdropStyle, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Header="{loc:Tr Key=Settings.WslcSectionTitle.Text}"
                Description="{loc:Tr Key=Settings.WslcManagementHint}"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="{loc:Tr Key=Settings.CurrentVersionLabel.Text}"
                        Description="{x:Bind ViewModel.WslcActionMessage, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.WslcCurrentVersion, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.WslcLatestVersion, Mode=OneWay}" />
                            <Button Command="{x:Bind ViewModel.CheckWslcCommand}" Content="{loc:Tr Key=About.CheckUpdateButton.Content}" />
                            <Button Command="{x:Bind ViewModel.InstallWslcCommand}" Content="{x:Bind ViewModel.WslcActionText, Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Header="{loc:Tr Key=Settings.DatabaseSectionTitle.Text}"
                Description="{loc:Tr Key=Settings.DatabaseHint}"
                IsExpanded="False">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE74E;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="{loc:Tr Key=Settings.DatabasePathLabel.Text}"
                        Description="{x:Bind ViewModel.DatabasePath, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=Settings.AuditCountLabel.Text}" />
                                <TextBlock Text="{x:Bind ViewModel.AuditCount, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=Settings.PullCountLabel.Text}" />
                                <TextBlock Text="{x:Bind ViewModel.PullCount, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=Settings.SnapshotCountLabel.Text}" />
                                <TextBlock Text="{x:Bind ViewModel.SnapshotCount, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
