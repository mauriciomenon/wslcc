<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WSLCC.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:WSLCC_App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WSLCC.Core.Models"
    xmlns:vm="using:WSLCC.App.ViewModels"
    mc:Ignorable="d"
    x:DataType="vm:HomeViewModel">

    <ScrollViewer>
        <Grid Padding="32,24,32,32" RowSpacing="16">
<Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{loc:Tr Key=HomePage.DashboardTitle.Text}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.TodayText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Content="{loc:Tr Key=HomePage.RefreshButton.Content}" />
                </StackPanel>
            </Grid>

<StackPanel Grid.Row="1" Spacing="8">
                <InfoBar
                    x:Name="ErrorBar"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Title="{loc:Tr Key=HomePage.ErrorInfoBar.Title}" />

                <InfoBar
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="Success"
                    Title="{loc:Tr Key=HomePage.StatusInfoBar.Title}" />

                <InfoBar
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasNetworkWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.NetworkWarningText, Mode=OneWay}"
                    Severity="Warning"
                    Title="{loc:Tr Key=HomePage.NetworkWarningInfoBar.Title}" />
            </StackPanel>

            <Border
                Grid.Row="2"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasGuidance, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="13"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE946;" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Tr Key=HomePage.GuidanceTitle.Text}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.GuidanceSteps, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel
                                    Margin="0,2"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="›" />
                                    <TextBlock MaxWidth="640" TextWrapping="Wrap" Text="{x:Bind}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE160;" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{loc:Tr Key=HomePage.ActiveSessionsCaption.Text}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.ActiveSessions, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
Glyph="&#xEB9F;" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{loc:Tr Key=HomePage.ImagesCaption.Text}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.ImagesCount, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE7F4;" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{loc:Tr Key=HomePage.ContainersCaption.Text}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.ContainerDetailText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.ContainersCount, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="3"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE81C;" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{loc:Tr Key=HomePage.AuditCaption.Text}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.AuditCount, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

<Grid Grid.Row="4" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="13"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE930;" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Tr Key=HomePage.EnvironmentTitle.Text}" />
                        </StackPanel>
                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=HomePage.WslcVersionCaption.Text}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.WslcVersion, Mode=OneWay}" />

                            <TextBlock Grid.Row="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=HomePage.KernelVersionCaption.Text}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.KernelVersion, Mode=OneWay}" />

                            <TextBlock Grid.Row="2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=HomePage.WindowsVersionCaption.Text}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.WindowsVersion, Mode=OneWay}" />

                            <TextBlock Grid.Row="3" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=HomePage.SessionManagerCaption.Text}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.SessionManagerVersion, Mode=OneWay}" />

                            <TextBlock Grid.Row="4" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=HomePage.MissingComponentsCaption.Text}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.MissingComponents, Mode=OneWay}" />

                            <TextBlock Grid.Row="5" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=HomePage.ApiStatusCaption.Text}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.ApiStatus, Mode=OneWay}" />

                            <TextBlock Grid.Row="6" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=HomePage.DatabaseCaption.Text}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.DatabasePath, Mode=OneWay}" />

                            <TextBlock Grid.Row="7" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=HomePage.SettingsFileCaption.Text}" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.SettingsFile, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="13"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE7F3;" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Tr Key=HomePage.QuotaTitle.Text}" />
                        </StackPanel>
                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=HomePage.QuotaCpuCaption.Text}" />
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{x:Bind ViewModel.QuotaCpu, Mode=OneWay}" />

                            <TextBlock Grid.Row="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=HomePage.QuotaMemoryCaption.Text}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="{x:Bind ViewModel.QuotaMemory, Mode=OneWay}" />

                            <TextBlock Grid.Row="2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:Tr Key=HomePage.QuotaStorageCaption.Text}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="{x:Bind ViewModel.QuotaStorage, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="13"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE7F4;" />
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Tr Key=HomePage.SessionListTitle.Text}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    Padding="8,3"
                                    Click="StartSessions_Click"
                                    Content="{loc:Tr Key=ContainersPage.StartButton.Content}" />
                                <Button
                                    Padding="8,3"
                                    Click="TerminateSessions_Click"
                                    Content="{loc:Tr Key=HomePage.TerminateButton.Content}" />
                                <Button
                                    Padding="8,3"
                                    Click="RestartSessions_Click"
                                    Content="{loc:Tr Key=HomePage.RestartButton.Content}" />
                            </StackPanel>
                        </Grid>
                        <ListView
                            MinHeight="90"
                            ItemsSource="{x:Bind ViewModel.SessionList, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,2" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:WslcSessionInfo">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE8B7;" />
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Name, Mode=OneTime}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="8,3"
                                            Click="OpenSessionTerminal_Click"
                                            Content="{loc:Tr Key=ContainersPage.TerminalButton.Content}"
                                            Tag="{x:Bind Name}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

