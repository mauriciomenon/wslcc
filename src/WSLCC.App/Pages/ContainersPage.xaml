<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WSLCC.App.Pages.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:WSLCC_App"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WSLCC.App.ViewModels"
    xmlns:controls="using:WSLCC.App.Controls"
    mc:Ignorable="d"
    x:DataType="vm:ContainersViewModel">

    <Grid Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

<Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{loc:Tr Key=ContainersPage.Title.Text}"
                VerticalAlignment="Center" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="{loc:Tr Key=ContainersPage.RefreshButton.Content}" />
                <Button
                    Click="PruneStopped_Click"
                    Content="{loc:Tr Key=Prune.ContainersButton.Content}" />
                <Button
                    Click="CopyFiles_Click"
                    Content="{loc:Tr Key=ContainersPage.CopyButton.Content}" />
                <Button
                    Click="NewContainer_Click"
                    Content="{loc:Tr Key=ContainersPage.NewButton.Content}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Name="ErrorBar"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Title="{loc:Tr Key=ContainersPage.ErrorInfoBar.Title}" />

            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasNetworkWarning, Mode=OneWay}"
                Message="{x:Bind ViewModel.NetworkWarningText, Mode=OneWay}"
                Severity="Warning"
                Title="{loc:Tr Key=ContainersPage.NetworkWarningInfoBar.Title}" />

            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasReparseWarning, Mode=OneWay}"
                Message="{x:Bind ViewModel.ReparseWarningText, Mode=OneWay}"
                Severity="Warning"
                Title="{loc:Tr Key=ContainersPage.ReparseWarningInfoBar.Title}" />
        </StackPanel>

<Grid Grid.Row="2">
            <controls:SkeletonGrid IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <Grid
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsHitTestVisible="False"
                Text="{loc:Tr Key=ContainersPage.EmptyText.Text}"
                Visibility="{x:Bind ViewModel.HasContainers, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

            <GridView
                ItemsSource="{x:Bind ViewModel.Containers, Mode=OneWay}"
                IsItemClickEnabled="False"
                SelectionMode="None"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.HasContainers, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="4" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContainerItemViewModel">
                        <Border
                            Width="320"
                            MinHeight="128"
                            Padding="14,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
<Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse
                                        Width="10" Height="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                        Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                    <Ellipse
                                        Width="10" Height="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{x:Bind IsRunning, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{x:Bind Name}" />
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            Source="{x:Bind IconSource, Mode=OneWay}"
                                            Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                        <Button
                                            MinWidth="0" MinHeight="0"
                                            Padding="8,3"
                                            Click="ContainerAction_Click"
                                            Content="{loc:Tr Key=ContainersPage.OpenWebButton.Content}"
                                            Tag="web"
                                            Visibility="{x:Bind HasWebUrl, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind Image}" />

<TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Ports}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ResourceText, Mode=OneWay}" />

                                <Border
                                    Grid.Row="4"
                                    Height="1"
                                    Margin="0,6,0,6"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

<StackPanel
                                    Grid.Row="5"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal"
                                    Spacing="4">
<Button
                                        MinWidth="0" MinHeight="0" Padding="6,3"
                                        Click="ContainerAction_Click"
                                        Content="{loc:Tr Key=ContainersPage.StartButton.Content}"
                                        Tag="start"
                                        Visibility="{x:Bind IsRunning, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />
                                    <Button
                                        MinWidth="0" MinHeight="0" Padding="6,3"
                                        Click="ContainerAction_Click"
                                        Content="{loc:Tr Key=ContainersPage.StopButton.Content}"
                                        Tag="stop"
                                        Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                    <Button
                                        MinWidth="0" MinHeight="0" Padding="6,3"
                                        Click="ContainerAction_Click"
                                        Content="{loc:Tr Key=ContainersPage.RestartButton.Content}"
                                        Tag="restart"
                                        Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                    <Button
                                        MinWidth="0" MinHeight="0" Padding="6,3"
                                        Click="ContainerAction_Click"
                                        Content="{loc:Tr Key=ContainersPage.LogsButton.Content}"
                                        Tag="logs" />
                                    <Button
                                        MinWidth="0" MinHeight="0" Padding="6,3"
                                        Click="ContainerAction_Click"
                                        Content="{loc:Tr Key=ContainersPage.InspectButton.Content}"
                                        Tag="inspect" />
                                    <Button
                                        MinWidth="0" MinHeight="0" Padding="6,3"
                                        Click="ContainerAction_Click"
                                        Content="{loc:Tr Key=ContainersPage.TerminalButton.Content}"
                                        Tag="terminal" />
                                    <Button
                                        MinWidth="0" MinHeight="0" Padding="6,3"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Click="ContainerAction_Click"
                                        Content="{loc:Tr Key=ContainersPage.DeleteButton.Content}"
                                        Tag="delete" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
</GridView.ItemTemplate>
            </GridView>
            </Grid>
        </Grid>
    </Grid>
</Page>






