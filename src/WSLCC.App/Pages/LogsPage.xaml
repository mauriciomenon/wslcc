<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WSLCC.App.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:WSLCC_App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WSLCC.App.ViewModels"
    mc:Ignorable="d"
    x:DataType="vm:LogsViewModel">

    <Grid Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{loc:Tr Key=Logs.TitleText.Text}"
                VerticalAlignment="Center" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="{loc:Tr Key=Logs.RefreshButton.Content}" />
            </StackPanel>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8">
            <ComboBox
                Width="280"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.ContainerNames, Mode=OneWay}"
                PlaceholderText="{loc:Tr Key=Logs.ContainerCombo.PlaceholderText}"
                SelectedItem="{x:Bind ViewModel.SelectedContainerName, Mode=TwoWay}" />
            <Button
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.LoadLogsCommand}"
                Content="{loc:Tr Key=Logs.LoadLogsButton.Content}" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="12">
            <TextBox
                Width="120"
                Header="{loc:Tr Key=LogsPage.TailHeader}"
                Text="{x:Bind ViewModel.TailText, Mode=TwoWay}" />
            <TextBox
                Width="220"
                Header="{loc:Tr Key=TimeFilter.Since}"
                PlaceholderText="{loc:Tr Key=TimeFilter.TimestampHint}"
                Text="{x:Bind ViewModel.SinceText, Mode=TwoWay}" />
            <TextBox
                Width="220"
                Header="{loc:Tr Key=TimeFilter.Until}"
                PlaceholderText="{loc:Tr Key=TimeFilter.TimestampHint}"
                Text="{x:Bind ViewModel.UntilText, Mode=TwoWay}" />
            <CheckBox
                VerticalAlignment="Bottom"
                Content="{loc:Tr Key=LogsPage.Timestamps}"
                IsChecked="{x:Bind ViewModel.ShowTimestamps, Mode=TwoWay}" />
            <CheckBox
                VerticalAlignment="Bottom"
                Content="{loc:Tr Key=LogsPage.Details}"
                IsChecked="{x:Bind ViewModel.ShowDetails, Mode=TwoWay}" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="3"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Warning"
            Title="{loc:Tr Key=Logs.LogErrorBar.Title}" />

        <TextBox
            Grid.Row="4"
            AcceptsReturn="True"
            FontFamily="Consolas"
            IsReadOnly="True"
            Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
            TextWrapping="NoWrap" />
    </Grid>
</Page>
